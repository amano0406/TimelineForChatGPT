@page "/jobs/{id}"
@model TimelineForChatGPT.Web.Pages.Runs.DetailsModel
@{
    ViewData["Title"] = T["Page.Details.Title"];
    var run = Model.Run!;
    var status = run.Status;
    var result = run.Result;
    var summary = run.ExportSummary;

    static int CompletedCount(TimelineForChatGPT.Web.Models.JobStatusDocument? source) =>
        (source?.ConversationsDone ?? 0) + (source?.ConversationsSkipped ?? 0) + (source?.ConversationsFailed ?? 0);

    static string FormatTimestamp(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : DateTimeOffset.TryParse(value, out var parsed)
            ? parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            : value;

    string LocalizeState(string? value) => T.TranslateState(value);
    string LocalizeStage(string? value) => T.TranslateStage(value);
    string LocalizeFlag(string value) => T.TranslateFlag(value);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h2 mb-1">@run.JobId</h1>
        <div class="text-muted">@run.RunDirectory</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Jobs/Index">@T["Nav.Jobs"]</a>
        @if (!string.IsNullOrWhiteSpace(result?.ArchivePath))
        {
            <a class="btn btn-primary" href="/jobs/@run.JobId/download">@T["Page.Details.DownloadZip"]</a>
        }
    </div>
</div>

<div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
    <div class="col">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <div class="small text-muted">@T["Page.Jobs.State"]</div>
            <div class="fw-semibold">@LocalizeState(status?.State)</div>
            <div class="small text-muted">@LocalizeStage(status?.CurrentStage)</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <div class="small text-muted">@T["Page.Jobs.Progress"]</div>
            <div class="fw-semibold">@status?.ProgressPercent.ToString("0.0")%</div>
            <div class="small text-muted">@CompletedCount(status) / @status?.ConversationsTotal</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <div class="small text-muted">@T["Page.Details.CurrentConversation"]</div>
            <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(status?.CurrentConversation) ? status.CurrentConversation : "-")</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <div class="small text-muted">@T["Page.Details.Updated"]</div>
            <div class="fw-semibold">@FormatTimestamp(status?.UpdatedAt)</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">@T["Page.Details.Result"]</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-6">@T["Page.Details.Processed"]</dt>
                    <dd class="col-sm-6">@result?.ProcessedCount</dd>
                    <dt class="col-sm-6">@T["Page.Details.Failed"]</dt>
                    <dd class="col-sm-6">@result?.ErrorCount</dd>
                    <dt class="col-sm-6">@T["Page.Details.BatchCount"]</dt>
                    <dd class="col-sm-6">@result?.BatchCount</dd>
                    <dt class="col-sm-6">@T["Page.Details.IndexPath"]</dt>
                    <dd class="col-sm-6 small text-break">@result?.ConversationIndexPath</dd>
                </dl>
            </div>
        </div>

        @if (summary is not null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">@T["Page.Details.ExportSummary"]</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-6">@T["Page.Details.Input"]</dt>
                        <dd class="col-sm-6">@summary.InputName</dd>
                        <dt class="col-sm-6">@T["Page.Details.ConversationFiles"]</dt>
                        <dd class="col-sm-6">@summary.ConversationFiles</dd>
                        <dt class="col-sm-6">@T["Page.Details.Conversations"]</dt>
                        <dd class="col-sm-6">@summary.TotalConversations</dd>
                        <dt class="col-sm-6">@T["Page.Details.Messages"]</dt>
                        <dd class="col-sm-6">@summary.TotalMessages</dd>
                        <dt class="col-sm-6">@T["Page.Details.DateRange"]</dt>
                        <dd class="col-sm-6 small">@summary.DateMinUtc<br />@summary.DateMaxUtc</dd>
                    </dl>
                </div>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">@T["Page.Details.WorkerLog"]</h2>
                @if (string.IsNullOrWhiteSpace(run.LogTail))
                {
                    <div class="text-muted">@T["Page.Details.NoLogYet"]</div>
                }
                else
                {
                    <pre class="small mb-0">@run.LogTail</pre>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 mb-0">@T["Page.Details.Conversations"]</h2>
                    <span class="badge text-bg-secondary">@run.Conversations.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                        <tr>
                            <th>@T["Page.Details.TableTitle"]</th>
                            <th>@T["Page.Details.Messages"]</th>
                            <th>@T["Page.Details.TableBranches"]</th>
                            <th>@T["Page.Details.TableAssets"]</th>
                            <th>@T["Page.Details.TableUpdated"]</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (run.Conversations.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">@T["Page.Details.ConversationIndexPending"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var conversation in run.Conversations)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@conversation.Title</div>
                                        <div class="small text-muted">@conversation.ConversationId</div>
                                        @if (conversation.HasToolMessages || conversation.HasSystemMessages || conversation.HasAttachments || conversation.HasMultimodalContent)
                                        {
                                            <div class="small mt-1 d-flex flex-wrap gap-1">
                                                @if (conversation.HasToolMessages)
                                                {
                                                    <span class="badge text-bg-secondary">@LocalizeFlag("tool")</span>
                                                }
                                                @if (conversation.HasSystemMessages)
                                                {
                                                    <span class="badge text-bg-light">@LocalizeFlag("system")</span>
                                                }
                                                @if (conversation.HasAttachments)
                                                {
                                                    <span class="badge text-bg-info">@LocalizeFlag("assets")</span>
                                                }
                                                @if (conversation.HasMultimodalContent)
                                                {
                                                    <span class="badge text-bg-warning">@LocalizeFlag("multimodal")</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div>@conversation.MainBranchMessageCount / @conversation.MessageCountTotal</div>
                                        <div class="small text-muted">@conversation.DefaultModelSlug</div>
                                    </td>
                                    <td>@conversation.BranchCount</td>
                                    <td>
                                        <div>@conversation.AttachmentCount</div>
                                        <div class="small text-muted">@T["Asset.ImageShort"] @conversation.ImageCount / @T["Asset.AudioShort"] @conversation.AudioCount</div>
                                    </td>
                                    <td>@FormatTimestamp(conversation.UpdateTime)</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="/Runs/Conversation"
                                           asp-route-id="@run.JobId"
                                           asp-route-conversationId="@conversation.ConversationId">
                                            @T["Page.Details.Timeline"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
