@page "/jobs/{id}/conversations/{conversationId}"
@model TimelineForChatGPT.Web.Pages.Runs.ConversationModel
@{
    ViewData["Title"] = T["Page.Conversation.Title"];
    var conversation = Model.Conversation!;

    static string FormatCounter(IReadOnlyDictionary<string, int>? payload) =>
        payload is null || payload.Count == 0
            ? "-"
            : string.Join(", ", payload.Where(static pair => pair.Value > 0).OrderBy(static pair => pair.Key).Select(static pair => $"{pair.Key}:{pair.Value}"));

    string LocalizeFlag(string value) => T.TranslateFlag(value);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h2 mb-1">@conversation.Title</h1>
        <div class="text-muted">@conversation.ConversationId</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Runs/Details" asp-route-id="@conversation.JobId">@T["Page.Conversation.Back"]</a>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">@T["Page.Conversation.Metadata"]</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-5">@T["Page.Conversation.Created"]</dt>
                    <dd class="col-sm-7">@conversation.CreateTime</dd>
                    <dt class="col-sm-5">@T["Page.Details.Updated"]</dt>
                    <dd class="col-sm-7">@conversation.UpdateTime</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.Started"]</dt>
                    <dd class="col-sm-7">@conversation.StartedAtUtc</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.Ended"]</dt>
                    <dd class="col-sm-7">@conversation.EndedAtUtc</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.Model"]</dt>
                    <dd class="col-sm-7">@conversation.DefaultModelSlug</dd>
                    <dt class="col-sm-5">@T["Page.Details.Messages"]</dt>
                    <dd class="col-sm-7">@conversation.MainBranchMessageCount / @conversation.MessageCountTotal</dd>
                    <dt class="col-sm-5">@T["Page.Details.TableBranches"]</dt>
                    <dd class="col-sm-7">@conversation.BranchCount</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.Assets"]</dt>
                    <dd class="col-sm-7">@conversation.AttachmentCount @T["Asset.Attachments"] / @conversation.ImageCount @T["Asset.Images"] / @conversation.AudioCount @T["Asset.Audio"]</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.ToolMessages"]</dt>
                    <dd class="col-sm-7">@conversation.ToolCount</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.Flags"]</dt>
                    <dd class="col-sm-7">
                        @if (conversation.HasToolMessages)
                        {
                            <span class="badge text-bg-secondary me-1">@LocalizeFlag("tool")</span>
                        }
                        @if (conversation.HasSystemMessages)
                        {
                            <span class="badge text-bg-light me-1">@LocalizeFlag("system")</span>
                        }
                        @if (conversation.HasAttachments)
                        {
                            <span class="badge text-bg-info me-1">@LocalizeFlag("assets")</span>
                        }
                        @if (conversation.HasMultimodalContent)
                        {
                            <span class="badge text-bg-warning me-1">@LocalizeFlag("multimodal")</span>
                        }
                        @if (!conversation.HasToolMessages && !conversation.HasSystemMessages && !conversation.HasAttachments && !conversation.HasMultimodalContent)
                        {
                            <span>-</span>
                        }
                    </dd>
                    <dt class="col-sm-5">@T["Page.Conversation.RoleCounts"]</dt>
                    <dd class="col-sm-7 small">@FormatCounter(conversation.RoleCountsTotal)</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.ContentTypes"]</dt>
                    <dd class="col-sm-7 small">@FormatCounter(conversation.ContentTypeCountsTotal)</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.MainBranchRoles"]</dt>
                    <dd class="col-sm-7 small">@FormatCounter(conversation.MainBranchRoleCounts)</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.MainBranchTypes"]</dt>
                    <dd class="col-sm-7 small">@FormatCounter(conversation.MainBranchContentTypeCounts)</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.TimelinePath"]</dt>
                    <dd class="col-sm-7 small text-break">@conversation.TimelinePath</dd>
                    <dt class="col-sm-5">@T["Page.Conversation.ConversationJson"]</dt>
                    <dd class="col-sm-7 small text-break">@conversation.ConversationJsonPath</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">@T["Page.Conversation.TimelineMarkdown"]</h2>
                <pre class="mb-0">@conversation.TimelineMarkdown</pre>
            </div>
        </div>
    </div>
</div>
