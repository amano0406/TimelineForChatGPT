@page "/jobs"
@model ChatGpt2Timeline.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = T["Page.Jobs.Title"];

    static int CompletedCount(ChatGpt2Timeline.Web.Models.RunSummary run) =>
        run.ConversationsDone + run.ConversationsSkipped + run.ConversationsFailed;

    static string FormatBytes(long value)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double size = value;
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return $"{size:0.0} {units[unitIndex]}";
    }

    static string FormatCreatedAt(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : DateTimeOffset.TryParse(value, out var parsed)
            ? parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            : value;

    string LocalizeState(string? value) => T.TranslateState(value);
    string LocalizeStage(string? value) => T.TranslateStage(value);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h2 mb-1">@T["Page.Jobs.Title"]</h1>
        <p class="text-muted mb-0">@T["Page.Jobs.Description"]</p>
    </div>
    <a class="btn btn-primary" asp-page="/Jobs/New">@T["Nav.NewJob"]</a>
</div>

@if (Model.ActiveRun is not null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="text-uppercase small text-muted">@T["Page.Jobs.ActiveJob"]</div>
                    <h2 class="h5 mb-1">@Model.ActiveRun.JobId</h2>
                    <div class="text-muted">@LocalizeState(Model.ActiveRun.State) / @LocalizeStage(Model.ActiveRun.CurrentStage)</div>
                </div>
                <a class="btn btn-outline-secondary" asp-page="/Runs/Details" asp-route-id="@Model.ActiveRun.JobId">@T["Page.Jobs.Open"]</a>
            </div>
            <div class="row row-cols-1 row-cols-md-4 g-3 mt-1">
                <div class="col">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">@T["Page.Jobs.Progress"]</div>
                        <div class="fw-semibold">@Model.ActiveRun.ProgressPercent.ToString("0.0")%</div>
                        <div class="small text-muted">@CompletedCount(Model.ActiveRun) / @Model.ActiveRun.ConversationsTotal</div>
                    </div>
                </div>
                <div class="col">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">@T["Page.Jobs.InputSize"]</div>
                        <div class="fw-semibold">@FormatBytes(Model.ActiveRun.TotalSizeBytes)</div>
                    </div>
                </div>
                <div class="col">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">@T["Page.Jobs.Remaining"]</div>
                        <div class="fw-semibold">@((Model.ActiveRun.EstimatedRemainingSec ?? 0).ToString("0.0")) @T["Unit.Seconds"]</div>
                    </div>
                </div>
                <div class="col">
                    <div class="border rounded p-3 h-100">
                        <div class="small text-muted">@T["Page.Jobs.Created"]</div>
                        <div class="fw-semibold">@FormatCreatedAt(Model.ActiveRun.CreatedAt)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 mb-3">@T["Page.Jobs.RecentJobs"]</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>@T["Page.Jobs.Job"]</th>
                    <th>@T["Page.Jobs.State"]</th>
                    <th>@T["Page.Jobs.Progress"]</th>
                    <th>@T["Page.Jobs.InputSize"]</th>
                    <th>@T["Page.Jobs.Created"]</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @if (Model.RecentRuns.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">@T["Page.Jobs.NoJobs"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var run in Model.RecentRuns)
                    {
                        <tr>
                            <td class="fw-semibold">@run.JobId</td>
                            <td>
                                <div>@LocalizeState(run.State)</div>
                                <div class="small text-muted">@LocalizeStage(run.CurrentStage)</div>
                            </td>
                            <td>
                                <div>@run.ProgressPercent.ToString("0.0")%</div>
                                <div class="small text-muted">@CompletedCount(run) / @run.ConversationsTotal</div>
                            </td>
                            <td>@FormatBytes(run.TotalSizeBytes)</td>
                            <td>@FormatCreatedAt(run.CreatedAt)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Runs/Details" asp-route-id="@run.JobId">@T["Page.Jobs.Details"]</a>
                                @if (run.HasDownloadableArchive)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="/jobs/@run.JobId/download">@T["Page.Jobs.DownloadZipShort"]</a>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
