@page
@model ErrorModel
@{
    ViewData["Title"] = T["Page.Error.Title"];
}

<h1 class="text-danger">@T["Page.Error.Header"]</h1>
<h2 class="text-danger">@T["Page.Error.Description"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T["Page.Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@T["Page.Error.DevelopmentMode"]</h3>
<p>
    @T["Page.Error.DevelopmentDescription"]
</p>
<p>
    <strong>@T["Page.Error.DevelopmentWarning"]</strong>
    @T["Page.Error.DevelopmentWarningBody"]
</p>
